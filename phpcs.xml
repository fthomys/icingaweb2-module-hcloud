<?xml version="1.0"?>
<ruleset name="hcloud">
    <description>PSR-12 with the 120 character line limit the Icinga modules use.</description>

    <file>application</file>
    <file>library</file>
    <file>dev</file>
    <file>test</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>

    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>*/configuration.php</exclude-pattern>
        <exclude-pattern>*/run.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/configuration.php</exclude-pattern>
        <exclude-pattern>*/run.php</exclude-pattern>
        <exclude-pattern>*/dev/*</exclude-pattern>
        <exclude-pattern>*/test/php/bootstrap.php</exclude-pattern>
    </rule>
</ruleset>
